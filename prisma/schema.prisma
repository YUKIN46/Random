// School Management System — Prisma Schema
// Multi-tenant: every record that belongs to a school hangs off Organization.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────────────────────────
// PLATFORM-WIDE SETTINGS (singleton, id fixed to "singleton")
// ─────────────────────────────────────────────

model PlatformSettings {
  id             String   @id @default("singleton")
  siteName       String   @default("Ledger")
  heroEyebrow    String   @default("Form 24-B · School Registration")
  heroHeadline   String   @default("One ledger for the whole school.")
  heroSubhead    String   @default("Attendance, grades, timetables, fees, and notices — kept the way a front office actually keeps them, organized by school. Every organization gets its own address and its own private records.")
  ctaLabel       String   @default("Register your school")
  supportEmail   String?
  updatedAt      DateTime @updatedAt
  updatedById    String?
}

// ─────────────────────────────────────────────
// PLATFORM / TENANCY
// ─────────────────────────────────────────────

enum OrgStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique // used as subdomain: {slug}.yourapp.com
  status      OrgStatus @default(PENDING)
  logoUrl     String?
  address     String?
  phone       String?
  contactEmail String
  timezone    String    @default("UTC")

  // approval workflow
  requestedById String?
  approvedAt    DateTime?
  approvedById  String?
  rejectionReason String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users         User[]
  students      Student[]
  teachers      Teacher[]
  classes       SchoolClass[]
  sections      Section[]
  subjects      Subject[]
  exams         Exam[]
  timetableSlots TimetableSlot[]
  feeStructures FeeStructure[]
  invoices      Invoice[]
  notes         Note[]
  announcements Announcement[]
  attendance    AttendanceRecord[]

  @@index([status])
}

enum Role {
  SUPER_ADMIN   // platform owner (you)
  ORG_ADMIN     // school admin
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String?
  emailVerified  DateTime?
  image          String?
  role           Role     @default(STUDENT)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  teacherProfile Teacher?
  studentProfile Student?
  guardianOf     Guardian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  @@index([organizationId])
  @@index([role])
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// ACADEMIC STRUCTURE
// ─────────────────────────────────────────────

model SchoolClass {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String   // e.g. "Grade 8"
  order          Int      @default(0)

  sections Section[]

  createdAt DateTime @default(now())

  @@unique([organizationId, name])
}

model Section {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classId        String
  schoolClass    SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name           String   // e.g. "A"
  classTeacherId String?
  classTeacher   Teacher? @relation(fields: [classTeacherId], references: [id])

  students   Student[]
  timetable  TimetableSlot[]
  attendance AttendanceRecord[]

  @@unique([classId, name])
  @@index([organizationId])
}

model Subject {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String?

  teacherLinks   TeacherSubject[]
  exams          Exam[]
  timetableSlots TimetableSlot[]

  @@unique([organizationId, name])
}

model Guardian {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentUserId   String
  parentUser     User     @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  relationship   String? // "Mother", "Father", "Guardian", etc.
  createdAt      DateTime @default(now())

  @@unique([studentId, parentUserId])
  @@index([parentUserId])
}

// ─────────────────────────────────────────────
// PEOPLE
// ─────────────────────────────────────────────

model Teacher {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeCode String?
  phone        String?
  joiningDate  DateTime?

  subjects       TeacherSubject[]
  sectionsLed    Section[]
  timetableSlots TimetableSlot[]

  @@index([organizationId])
}

model TeacherSubject {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
}

model Student {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  admissionNo String?
  sectionId   String?
  section     Section? @relation(fields: [sectionId], references: [id])
  dateOfBirth DateTime?
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  address     String?

  attendance      AttendanceRecord[]
  examResults     ExamResult[]
  invoices        Invoice[]
  guardians       Guardian[]

  @@index([organizationId])
  @@index([sectionId])
}

// ─────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceRecord {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  date           DateTime
  status         AttendanceStatus
  remarks        String?

  createdAt DateTime @default(now())

  @@unique([studentId, date])
  @@index([organizationId, date])
}

// ─────────────────────────────────────────────
// EXAMS / GRADES
// ─────────────────────────────────────────────

model Exam {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name           String   // e.g. "Mid Term 2026"
  examDate       DateTime
  maxMarks       Float    @default(100)
  passMarks      Float    @default(35)

  results ExamResult[]

  @@index([organizationId])
}

model ExamResult {
  id        String  @id @default(cuid())
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marksObtained Float
  grade     String?
  remarks   String?

  @@unique([examId, studentId])
}

// ─────────────────────────────────────────────
// TIMETABLE
// ─────────────────────────────────────────────

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model TimetableSlot {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  day            Weekday
  startTime      String   // "09:00"
  endTime        String   // "09:45"

  @@index([organizationId, sectionId, day])
}

// ─────────────────────────────────────────────
// FEES / BILLING
// ─────────────────────────────────────────────

model FeeStructure {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String   // e.g. "Grade 8 Annual Tuition"
  amount         Float
  frequency      String   // "MONTHLY" | "QUARTERLY" | "ANNUAL" | "ONE_TIME"

  invoices Invoice[]

  @@index([organizationId])
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])

  amountDue   Float
  amountPaid  Float   @default(0)
  dueDate     DateTime
  status      InvoiceStatus @default(UNPAID)

  payments Payment[]

  createdAt DateTime @default(now())

  @@index([organizationId, status])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   // "CASH" | "CARD" | "BANK_TRANSFER" | "ONLINE"
  reference String?
  paidAt    DateTime @default(now())
}

// ─────────────────────────────────────────────
// NOTES / ANNOUNCEMENTS
// ─────────────────────────────────────────────

model Note {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String
  title          String
  content        String
  visibility     String   // "SECTION" | "CLASS" | "ORG" | "TEACHER_ONLY"
  targetSectionId String?

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model Announcement {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String
  title          String
  body           String
  pinned         Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([organizationId])
}
